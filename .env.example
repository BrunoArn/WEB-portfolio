# Public Sanity project configuration used by the Next.js frontend.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only secret matching the Secret field of the Sanity webhook.
# Required in an environment receiving webhook deliveries; returns 503 when unset.
SANITY_REVALIDATE_SECRET=

# Set to the official HTTPS origin in the public deployment only.
SEO_CANONICAL_ORIGIN=
# Set to true and rebuild the official deployment when indexing is approved.
SEO_INDEXING_ENABLED=false
