# Public Sanity project configuration used by the Next.js frontend.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only secret matching the Secret field of the Sanity webhook.
# Optional until activation; the endpoint returns 503 when unset.
SANITY_REVALIDATE_SECRET=

# Canonical production URL, for example:
# https://example.com
# Can remain empty during local development.
SITE_URL=